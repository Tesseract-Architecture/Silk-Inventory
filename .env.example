# Copiar a .env y completar. NUNCA subir .env a git.

# URL con la que la gente entra a la app (tiene que coincidir con la redirect URI de Entra)
APP_URL=https://inventario.silk.local
# Nombre que usa Caddy para el certificado (el host de APP_URL)
SITE_ADDRESS=inventario.silk.local

# Clave larga y aleatoria para firmar las cookies de sesión.
# Generar con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Login con Microsoft (Entra ID). Ver README y la guía SSO-Microsoft-Entra.md (la misma que Silk Pilot). ---
# Tenant de Silk Tech SRL (fijo). Client ID y secreto salen del registro de la app en Entra.
ENTRA_TENANT_ID=bb8c89f1-1a6a-4f96-ada2-0f2b7f9704b3
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Solo dejar entrar mails de estos dominios (separados por coma)
ALLOWED_EMAIL_DOMAINS=silk-technologies.com
# Siempre admins (el primer usuario que entra también queda como admin)
ADMIN_EMAILS=maximiliano.bianchimano@silk-technologies.com

# WhatsApp (1 = habilitado). Se vincula escaneando el QR en Administración.
WHATSAPP_ENABLED=1

TZ=America/Argentina/Buenos_Aires

# SOLO para probar en una PC sin Microsoft. Nunca en el server.
# AUTH_DEV=1
